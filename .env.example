# ---------------------------------------------------------------- MERLIN
# auto   : Fabric si configuré et joignable, sinon données de démonstration
# mock   : toujours les données de démonstration
# fabric : toujours Fabric (erreur si injoignable)
MERLIN_DATA_MODE=auto
MERLIN_DATA_DIR=data
MERLIN_TIMEZONE=Europe/Paris
MERLIN_DEFAULT_USER=Apprenti anonyme
MERLIN_JOB_TIMEOUT=1800
MERLIN_MAX_PARALLEL_JOBS=4
MERLIN_SEED_DEMO_HISTORY=true
MERLIN_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- Fabric (SQL endpoint du Lakehouse)
# Fabric > Lakehouse > SQL analytics endpoint > « Copier la chaîne de connexion »
FABRIC_SQL_ENDPOINT=
FABRIC_DATABASE=LKH_RFPTeam_Bronze
# ActiveDirectoryInteractive (poste de travail) | ActiveDirectoryServicePrincipal | ActiveDirectoryDefault
FABRIC_AUTH=ActiveDirectoryInteractive
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_TENANT_ID=
FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server
FABRIC_TIMEOUT=30

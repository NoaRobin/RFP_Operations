# ---------------------------------------------------------------- MERLIN
# auto   : Fabric si configuré et joignable, sinon données de démonstration
# mock   : toujours les données de démonstration
# fabric : toujours Fabric (erreur si injoignable)
MERLIN_DATA_MODE=auto
MERLIN_DATA_DIR=data
MERLIN_TIMEZONE=Europe/Paris
MERLIN_DEFAULT_USER=Utilisateur anonyme
MERLIN_JOB_TIMEOUT=1800
MERLIN_MAX_PARALLEL_JOBS=4
MERLIN_SEED_DEMO_HISTORY=true
MERLIN_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- Fabric (SQL endpoint du Lakehouse)
# Fabric > Lakehouse > SQL analytics endpoint > « Copier la chaîne de connexion »
FABRIC_SQL_ENDPOINT=
FABRIC_DATABASE=LKH_RFPTeam_Bronze
# ActiveDirectoryInteractive (poste de travail) | ActiveDirectoryServicePrincipal | ActiveDirectoryDefault
FABRIC_AUTH=ActiveDirectoryInteractive
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_TENANT_ID=
FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server
FABRIC_TIMEOUT=30
# Identifiant Microsoft pour la fenêtre de connexion (rempli automatiquement par l'écran « Se connecter à Fabric »)
FABRIC_USER=
# mssql-python (recommandé, comme l'extension VS Code mssql) | pyodbc (nécessite le pilote ODBC 18)
FABRIC_CLIENT=mssql-python
# thread (défaut : une seule fenêtre Microsoft partagée) | process (isolation forte des sorts)
MERLIN_JOB_EXECUTOR=thread

# ---------------------------------------------------------------- SharePoint (RFI déjà répondus : précédents)
# Site « AM RFP CONF DOC » et dossier racine des due diligences
SHAREPOINT_SITE_URL=https://reachbcp1.sharepoint.com/sites/S001314
SHAREPOINT_LIBRARY=Shared Documents
SHAREPOINT_ROOT=1 - Appels d'offres - Due diligence
# Option 1 (sans inscription) : chemin du dossier synchronisé OneDrive (« Synchroniser » dans SharePoint), ex.
#   C:\Users\<vous>\<Organisation>\AM RFP CONF DOC - Documents\1 - Appels d'offres - Due diligence
# Laisser vide : l'application cherche elle-même un dossier synchronisé dans votre profil.
SHAREPOINT_LOCAL_DIR=
# Option 2 : Microsoft Graph (connexion Microsoft interactive). Application Entra ID « client public »
# créée par l'IT, droits délégués Sites.Read.All, redirection http://localhost. Aucun secret.
SHAREPOINT_CLIENT_ID=
SHAREPOINT_TENANT_ID=

# ---------------------------------------------------------------- Documents officiels (DIC PRIIPs, prospectus)
# auto : site public interrogé seulement avec Fabric (fonds réels) ; on : toujours ; off : jamais (dépôts manuels seuls)
FUND_DOCS=auto
FUND_SITE_URL=https://am.eu.rothschildandco.com
FUND_SITE_FUND_PATH=/en/our-funds/{slug}/
FUND_SITE_SEARCH_PATH=/en/search/?q={isin}
# Dossier local facultatif (ex. bibliothèque SharePoint « Documentation » synchronisée) : PDF dont le nom contient l'ISIN
FUND_DOCS_DIR=

# ---------------------------------------------------------------- Téléchargement des documents des fonds (« liste de courses »)
# Dossier de destination (ex. C:\Users\<vous>\...\7 - Ressources\Stagiaire\FundShop) ; vide = data/fundshop/documents
FUNDSHOP_DIR=
FUNDSHOP_DOCS_BASE=https://docs.am.eu.rothschildandco.com
FUNDSHOP_SITE_BASE=https://am.eu.rothschildandco.com/fr/nos-fonds/
# Profil choisi sur l'écran d'accueil du site : professional (défaut) ou individual
FUNDSHOP_PROFILE=professional

# ---------------------------------------------------------------- OMNI mensuel
# Racine des dossiers consultants (synchronisée) : …\AM-RFP-CONF - Documents\3 - Consultants ; vide = data/omni
OMNI_ROOT=
# Dossier où déposer les performances NET / GROSS si Outlook n'est pas utilisé ; vide = data/omni/depot
OMNI_INBOX=
# Outlook : expéditeur des performances et mots de l'objet
OMNI_SENDER=
OMNI_SUBJECT_WORDS=perf,omni
# Mode « JUMP Excel » (gabarit strictement identique, Windows) : chemin de JUMP_OMNI.py
OMNI_JUMP_SCRIPT=
